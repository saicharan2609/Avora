{
  "name": "@avora/ai",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
  "types": "./src/index.ts",
  "import": "./dist/src/index.js",
  "default": "./dist/src/index.js"
},
    "./gateway": "./dist/gateway/index.js",
    "./gateway/budget-gate": "./dist/gateway/budget-gate/index.js",
    "./gateway/context": "./dist/gateway/context/index.js",
    "./gateway/envelope": "./dist/gateway/envelope/index.js",
    "./gateway/invocation": "./dist/gateway/invocation/index.js",
    "./gateway/validation": "./dist/gateway/validation/index.js",
    "./gateway/tutor": "./dist/gateway/tutor/index.js",
    "./gateway/summary": "./dist/gateway/summary/index.js",
    "./gateway/citations": "./dist/gateway/citations/index.js",
    "./gateway/telemetry": "./dist/gateway/telemetry/index.js",
    "./ports": "./dist/ports/index.js",
    "./adapters": "./dist/adapters/index.js",
    "./embeddings": {
  "types": "./dist/embeddings/index.d.ts",
  "default": "./dist/embeddings/index.js"
},
    "./adapters/antigravity": "./dist/adapters/antigravity/index.js",
    "./adapters/anthropic": "./dist/adapters/anthropic/index.js",
    "./adapters/openai": "./dist/adapters/openai/index.js",
    "./adapters/google": "./dist/adapters/google/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:arch": "eslint .",
    "test:contract": "pnpm run build && node dist/adapters/google/__tests__/GeminiEmbeddingAdapter.contract.js && node dist/adapters/google/__tests__/GeminiTutorAnswerAdapter.contract.js && node dist/adapters/google/__tests__/StreamingJsonAnswerExtractor.unit.js && node dist/embeddings/__tests__/ContentAddressedEmbeddingPort.contract.js && node dist/adapters/google/__tests__/GeminiSummaryAdapter.contract.js"

  },
  "dependencies": {
    "@avora/core": "workspace:*",
    "@avora/db": "workspace:*",
    "@avora/retrieval": "workspace:*",
    "@google/genai": "2.18.0"
  },
  "devDependencies": {
    "@avora/config": "workspace:*"
  }
}