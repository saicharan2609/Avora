{
  "extends": "../config/typescript/node.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "lib": [
      "ES2024"
    ],
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "client/**/*.ts",
    "generated/**/*.ts",
    "repositories/**/*.ts",
    "ports/**/*.ts",
    "rls/**/*.ts"
  ],
  "references": [
    {
      "path": "../config"
    },
    {
      "path": "../core"
    }
  ]
}