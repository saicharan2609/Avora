{
  "name": "@avora/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./client/index.ts",
    "./generated": "./generated/index.ts",
    "./repositories": "./repositories/index.ts",
    "./ports": "./ports/index.ts",
    "./rls": "./rls/index.ts",
    "./rls/harness": "./rls/harness/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:arch": "eslint .",
    "db:generate": "node scripts/generate-types.mjs",
    "db:diff": "node scripts/diff-placeholder.mjs",
    "db:lint": "node scripts/lint-supabase-artifacts.mjs",
    "test:rls": "node scripts/run-rls-harness.mjs"
  },
  "dependencies": {
    "@avora/core": "workspace:*"
  },
  "devDependencies": {
    "@avora/config": "workspace:*"
  }
}