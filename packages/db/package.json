{
  "name": "@avora/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js",
    "./client": "./dist/client/index.js",
    "./generated": "./dist/generated/index.js",
    "./repositories": "./dist/repositories/index.js",
    "./repositories/resources": "./dist/repositories/resources/index.js",
    "./ports": "./dist/ports/index.js",
    "./rls": "./dist/rls/index.js",
    "./rls/harness": "./dist/rls/harness/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:arch": "eslint .",
    "db:generate": "node scripts/generate-types.mjs",
    "db:diff": "node scripts/diff.mjs",
    "db:lint": "node scripts/lint-supabase-artifacts.mjs",
    "test:rls": "node scripts/run-rls-harness.mjs"
  },
  "dependencies": {
    "@avora/core": "workspace:*",
    "@supabase/supabase-js": "2.110.8"
  },
  "devDependencies": {
    "@avora/config": "workspace:*"
  }
}