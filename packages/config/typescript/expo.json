{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Avora Expo",
  "extends": "./base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "lib": [
      "ES2024"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,

    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true
  }
}