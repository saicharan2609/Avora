{
  "extends": "../config/typescript/expo.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tokens/**/*.ts",
    "primitives/**/*.ts",
    "primitives/**/*.tsx",
    "domain-components/**/*.ts",
    "domain-components/**/*.tsx"
  ],
  "references": [
    {
      "path": "../config"
    },
    {
      "path": "../core"
    },
    {
      "path": "../design-tokens"
    }
  ]
}