{
  "extends": "../config/typescript/node.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "lib": [
      "ES2024"
    ],
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "supabase/**/*.ts",
    "stripe/**/*.ts",
    "psp/**/*.ts",
    "resend/**/*.ts",
    "sentry/**/*.ts",
    "resource-placement/**/*.ts",
    "extraction/**/*.ts",
    "posthog/**/*.ts",
    "otel/**/*.ts"
  ],
  "references": [
    {
      "path": "../config"
    },
    {
      "path": "../core"
    },
    {
      "path": "../db"
    },
    {
      "path": "../domain"
    }
  ]
}