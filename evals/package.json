{
  "name": "@avora/evals",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./suites": "./suites/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:arch": "eslint .",
    "eval:ai": "pnpm run build && node dist/suites/run-ai-eval-gates.js",
    "eval:extraction": "pnpm run build && node dist/suites/run-resource-extraction-quality-gates.js",
    "eval:classification": "pnpm run build && node dist/suites/run-resource-classification-quality-gates.js",
    "eval:summary": "pnpm run build && node dist/suites/run-summary-grounding-gates.js"
  },
  "dependencies": {
    "@avora/ai": "workspace:*",
    "@avora/core": "workspace:*",
    "@avora/domain": "workspace:*"
  },
  "devDependencies": {
    "@avora/config": "workspace:*"
  }
}